{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hcc-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hcc-web"
		}
	],
	"vars": {
		"APP_ENV": "production"
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "hcc-web-preview",
				"database_id": "13f1762c-87d8-4b69-a644-82b16a89e98a"
			}
		],
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "3dd3d359df874877868012513bd59df7"
			}
		],
		"vars": {
			"APP_ENV": "preview",
			"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
			"TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
		}
	}
}
