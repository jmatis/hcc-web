{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hcc-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hcc-web"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "hcc-web-media"
		}
	],
	"vars": {
		"APP_ENV": "production"
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "hcc-web-preview"
			}
		],
		"r2_buckets": [
			{
				"binding": "MEDIA",
				"bucket_name": "hcc-web-media-preview"
			}
		],
		"vars": {
			"APP_ENV": "preview",
			"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
			"TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
		}
	}
}
