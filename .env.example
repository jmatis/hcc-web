# Generate a unique production value and store it as a Cloudflare secret.
EMDASH_ENCRYPTION_KEY=replace-with-a-random-secret

# Local development only. Production member authentication uses Cloudflare Access.
DEV_MEMBER_EMAIL=member@example.org

# Cloudflare Access application settings for /members and /api/members/*.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-access-application-aud-tag

# Use Cloudflare's official test keys locally; use real widget keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
